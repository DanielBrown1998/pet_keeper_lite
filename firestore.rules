rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user's family code (returns null if not set)
    function userFamily() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData != null ? userData.familyCode : null;
    }
    
    // Helper to check if user has a family
    function hasFamily() {
      return userFamily() != null;
    }
    
    // Users collection - users can only read/write their own document
    match /users/{uid} {
      allow read, write: if isAuthenticated() && uid == request.auth.uid;
    }
    
    // Families collection - members can read/write, anyone authenticated can create or check if exists
    match /families/{familyCode} {
      // Allow read to check if family exists (for joining) or if user is member
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && hasFamily() && familyCode == userFamily();
    }
    
    // Pets collection - only family members can CRUD
    match /pets/{petId} {
      // Allow read if user is authenticated and pet belongs to user's family
      allow read: if isAuthenticated() 
        && resource.data.familyCode == userFamily();
      
      // Allow create if user is authenticated and setting correct family code
      allow create: if isAuthenticated() 
        && request.resource.data.familyCode == userFamily();
      
      // Allow update if pet belongs to user's family and family code isn't changed
      allow update: if isAuthenticated() 
        && resource.data.familyCode == userFamily()
        && request.resource.data.familyCode == userFamily();
      
      // Allow delete if pet belongs to user's family
      allow delete: if isAuthenticated() 
        && resource.data.familyCode == userFamily();
    }
    
    // Pet tasks collection - simplified rules for the challenge
    match /pet_tasks/{taskId} {
      // Allow read/write if authenticated
      // In production, add proper validation to ensure task belongs to family's pet
      allow read, write: if isAuthenticated();
    }
  }
}
