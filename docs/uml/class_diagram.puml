TaskEmptyState --|> TaskState
TaskErrorState --|> TaskState

NotificationInitialState --|> NotificationState
NotificationSendingState --|> NotificationState
NotificationSuccessState --|> NotificationState
NotificationErrorState --|> NotificationState

' Blocs emit States
AuthBloc ..> AuthState : emits
FamilyBloc ..> FamilyState : emits
PetBloc ..> PetState : emits
TaskBloc ..> TaskState : emits
NotificationBloc ..> NotificationState : emits

' Failure hierarchy
